# Environment variables for mobile app
# Copy this to .env and fill in your values

# API Configuration
API_URL=http://localhost:8000

# App Configuration
APP_NAME=RedThread
APP_BUNDLE_ID=com.redthread.app

# OAuth (optional)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=

# Analytics (optional)
ANALYTICS_KEY=

# Sentry (optional)
SENTRY_DSN=
