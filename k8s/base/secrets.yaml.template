apiVersion: v1
kind: Secret
metadata:
  name: redthread-secrets
type: Opaque
stringData:
  # MongoDB credentials
  mongodb-username: "admin"
  mongodb-password: "CHANGE_ME_IN_PRODUCTION"
  mongodb-url: "mongodb://admin:CHANGE_ME_IN_PRODUCTION@mongodb:27017/redthread?authSource=admin"
  
  # Application secrets
  secret-key: "CHANGE_ME_IN_PRODUCTION_USE_STRONG_KEY"
  
  # OAuth credentials (optional)
  google-client-id: ""
  google-client-secret: ""
  facebook-client-id: ""
  facebook-client-secret: ""
  
  # Stripe credentials (optional)
  stripe-secret-key: ""
  stripe-publishable-key: ""
  stripe-webhook-secret: ""
