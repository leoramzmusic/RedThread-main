{
  "name": "redthread-frontend",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "npm run lint && npm run typecheck && npm test -- --ci",
    "validate:quick": "npx lint-staged",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.js",
    "i18n:extract:watch": "i18next-scanner --config i18next-scanner.config.js --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@gsap/react": "^2.1.2",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@svg-animated-icons/react": "^0.1.2",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "canvas-confetti": "^1.9.4",
    "country-codes-list": "^2.0.0",
    "date-fns": "^4.1.0",
    "emoji-mart": "^5.6.0",
    "fix": "^0.0.3",
    "formik": "^2.4.9",
    "gsap": "^3.15.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.2",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide": "^1.45.0",
    "morphicons": "^1.7.1",
    "next": "^16.0.5",
    "next-i18next": "^15.4.2",
    "notistack": "^3.0.2",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.7",
    "react-country-state-city": "^1.1.13",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "recharts": "^3.5.1",
    "socket.io-client": "^4.8.1",
    "use-debounce": "^10.0.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/aria-query": "^5.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/react-redux": "^7.1.34",
    "aria-query": "^5.3.2",
    "baseline-browser-mapping": "^2.9.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-security": "^4.0.1",
    "i18next-scanner": "^4.6.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.8.0",
    "npm": ">=10.0.0"
  }
}
